# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis+async://localhost:6379/0

# --- TTS gratuito ---
TTS_ENGINE=gtts
TTS_LANG=it

# --- Generazione immagini (locale/gratuita con diffusers) ---
USE_LOCAL_SD=false
SD_MODEL_ID=stabilityai/stable-diffusion-2-1

# --- Video ---
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
MAX_VIDEO_DURATION=300
SUBTITLE_FONT=assets/fonts/NotoSans-Regular.ttf

# --- Storage (Supabase Storage per file) ---
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_SERVICE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_BUCKET=videos

# --- Paths locali ---
OUTPUT_DIR=./output
ASSETS_DIR=./assets
LOG_LEVEL=INFO
