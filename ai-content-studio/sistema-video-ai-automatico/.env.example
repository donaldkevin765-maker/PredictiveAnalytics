# Database
DATABASE_URL=sqlite+aiosqlite:///./data/video_ai.db

# Redis (opzionale - per Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM - Ollama (locale, gratis)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
SCRIPT_SEED=42

# TTS - scegli: gtts | pyttsx3 | coqui | elevenlabs
TTS_ENGINE=gtts
TTS_LANG=it
TTS_VOICE_ID=
TTS_SPEED=1.0

# ElevenLabs TTS (gratuito: 10k char/mese)
# Registrati su https://elevenlabs.io, prendi API key da Profile > API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (inglese),  o una custom

# Notion API (gratuita, per tenere traccia dei progetti video)
# Crea un'integrazione su https://www.notion.so/my-integrations
# Poi condividi un database con l'integrazione e copia l'ID del database
NOTION_API_KEY=
NOTION_DATABASE_ID=

# n8n (open source, self-hosted)
# docker run -it --rm -p 5678:5678 n8nio/n8n
# Crea un workflow con Webhook trigger e copia l'URL
N8N_WEBHOOK_URL=

# DeepL Translation (gratuito: 500k caratteri/mese)
# Registrati su https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Google Gemini API (gratuito: 60 richieste/minuto)
# Prendi API key su https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API (gratuito: 30 richieste/minuto, inferenza velocissima)
# Prendi API key su https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (gateway 200+ modelli AI, $1 credito gratuito + modelli free)
# Prendi API key su https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelli gratuiti consigliati: mistralai/mistral-7b-instruct:free, google/gemma-2-9b-it:free
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Pexels (stock video/foto gratuiti, con attribuzione)
# Prendi API key su https://www.pexels.com/api/
PEXELS_API_KEY=

# Image generation
USE_LOCAL_SD=false
SD_MODEL_ID=stabilityai/stable-diffusion-2-1
HF_API_TOKEN=

# Video
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
MAX_VIDEO_DURATION=300

# Supabase (opzionale - per storage cloud)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=videos

# Webhook (opzionale)
WEBHOOK_URL=
WEBHOOK_SECRET=

DEFAULT_LANGUAGE=it

LOG_LEVEL=INFO
