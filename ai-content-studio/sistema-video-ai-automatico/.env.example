# Database
DATABASE_URL=sqlite+aiosqlite:///./data/video_ai.db

# Redis (opzionale - per Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM - Ollama (locale, gratis)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
SCRIPT_SEED=42

# TTS
TTS_ENGINE=gtts
TTS_LANG=it
TTS_VOICE_ID=
TTS_SPEED=1.0

# Image generation
USE_LOCAL_SD=false
SD_MODEL_ID=stabilityai/stable-diffusion-2-1
HF_API_TOKEN=

# Video
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
MAX_VIDEO_DURATION=300

# Supabase (opzionale)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=videos

# Webhook (opzionale)
WEBHOOK_URL=
WEBHOOK_SECRET=

DEFAULT_LANGUAGE=it

LOG_LEVEL=INFO
